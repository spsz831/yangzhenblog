---
import "@/styles/global.css";
import { ModeToggle } from "@/components/ModeToggle";
import { Menu, Rss } from "lucide-react";
import WebVitals from "@/components/WebVitals.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "杨振的个人博客，记录 AI 工具体验、AI 短视频创作、项目探索与生活观察。",
  image = new URL("/avatar.jpg", Astro.site).toString(),
} = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - 杨振博客</title>
    <meta name="baidu-site-verification" content="codeva-PGmpZDM43W" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    

    <!-- Performance Optimization -->
    <link rel="preconnect" href="https://image-bed-worker.yangzhen0806.workers.dev" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preload" as="image" href="/avatar.jpg" />
    
    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta http-equiv="Content-Language" content="zh-CN" />
    
    <!-- Mobile Optimization -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020817" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="杨振博客" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Schema.org WebSite -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "杨振博客",
        "url": "https://yangzhenai.top",
        "author": {
          "@type": "Person",
          "name": "杨振",
          "url": "https://yangzhenai.top/about"
        },
        "description": "杨振的个人博客，记录 AI 工具体验、AI 短视频创作、项目探索与生活观察。"
      }
    </script>

    <!-- Favicons -->
    <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
    <link rel="apple-touch-icon" href="/avatar.jpg" />

    <!-- GEOInflow analytics -->
    <script
      is:inline
      defer
      src="https://stats.yangzhenai.top/script.js"
      data-website-id="9d5a420c-56ab-4a7f-8bab-6bd4cf96fe1c"
    ></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RR2CR2641T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RR2CR2641T');
    </script>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
     
      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }

      // Scroll Animation Observer
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target); // Only animate once
            }
          });
        }, observerOptions);

        const elements = document.querySelectorAll('.fade-in-section');
        elements.forEach(el => observer.observe(el));
      });
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-background text-foreground font-sans antialiased">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="container flex h-16 items-center justify-between">
        <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-2">
                <div class="h-8 w-8 rounded-full bg-muted overflow-hidden">
                    <img src="/avatar.jpg" alt="杨振" class="h-full w-full object-cover" />
                </div>
                <span class="font-bold text-lg">杨振</span>
            </a>
        </div>
        
        <div class="flex items-center gap-3 md:gap-6">
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                <a class="transition-colors hover:text-foreground/80 text-foreground/60" href="/">首页</a>
                <a class="transition-colors hover:text-foreground/80 text-foreground/60" href="/posts">博客</a>
                <a class="transition-colors hover:text-foreground/80 text-foreground/60" href="/projects">项目</a>
                <a class="transition-colors hover:text-foreground/80 text-foreground/60" href="/about">关于</a>
            </nav>
            <details class="relative md:hidden">
                <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="打开导航菜单">
                    <Menu className="h-5 w-5" aria-hidden="true" />
                </summary>
                <nav aria-label="移动导航" class="absolute right-0 top-full z-50 mt-2 w-44 rounded-xl border border-border bg-popover p-2 text-sm shadow-lg">
                    <a class="block rounded-lg px-3 py-3 transition-colors hover:bg-accent" href="/">首页</a>
                    <a class="block rounded-lg px-3 py-3 transition-colors hover:bg-accent" href="/posts">博客</a>
                    <a class="block rounded-lg px-3 py-3 transition-colors hover:bg-accent" href="/projects">项目</a>
                    <a class="block rounded-lg px-3 py-3 transition-colors hover:bg-accent" href="/about">关于</a>
                </nav>
            </details>
            <div class="flex items-center gap-4">
                <ModeToggle client:load />
                <a href="/rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS Feed" class="inline-flex h-11 w-11 items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground">
                    <Rss className="h-[1.2rem] w-[1.2rem]" />
                </a>
            </div>
        </div>
      </div>
    </header>
    <main class="flex-1 container py-6 md:py-10">
      <slot />
    </main>
    <footer class="mt-8 border-t border-border py-6 md:px-8">
      <div class="container flex flex-col items-center justify-between gap-3 text-sm text-muted-foreground sm:flex-row">
        <p class="text-center leading-relaxed sm:text-left">© {new Date().getFullYear()} 杨振 · 记录 AI 实践、创作与生活</p>
        <nav aria-label="页脚导航" class="flex items-center gap-5">
          <a class="transition-colors hover:text-foreground" href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS</a>
          <a class="transition-colors hover:text-foreground" href="https://github.com/spsz831" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="transition-colors hover:text-foreground" href="mailto:yangzhen0806@gmail.com">联系我</a>
        </nav>
      </div>
    </footer>
    <WebVitals />
  </body>
</html>
