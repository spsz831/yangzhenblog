---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Github } from "lucide-react";

// Placeholder data for projects
const projects = [
  {
    title: "yangzhenblog",
    org: "spsz831",
    description: "基于 Astro 5 + Cloudflare D1 + React 构建的现代化个人博客系统。",
    url: "https://github.com/spsz831/yangzhenblog",
    icon: "🚀"
  },
  {
    title: "HTMLShare",
    org: "spsz831",
    description: "一个简单的 HTML 代码分享工具。",
    url: "https://github.com/spsz831/HTMLShare",
    icon: "🌐"
  },
  {
    title: "cloudflare-r2-image-bed",
    org: "spsz831",
    description: "基于 Cloudflare R2 和 Workers 构建的轻量级图床。",
    url: "https://github.com/spsz831/cloudflare-r2-image-bed",
    icon: "☁️"
  },
  {
    title: "PersonalProfile",
    org: "spsz831",
    description: "我的个人简介页面。",
    url: "https://github.com/spsz831/PersonalProfile",
    icon: "👤"
  }
];
---

<PublicLayout title="项目">
  <section class="container max-w-6xl py-6 lg:py-10">
    <div class="flex flex-col items-start gap-4 md:flex-row md:justify-between md:gap-8">
      <div class="flex-1 space-y-4">
        <h1 class="inline-block font-heading text-4xl tracking-tight lg:text-5xl">
          项目
        </h1>
        <p class="text-xl text-muted-foreground">
          我的开源项目和实验性作品。
        </p>
      </div>
    </div>
    <hr class="my-8" />
    
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <Card className="group relative h-full flex flex-col overflow-hidden border-muted-foreground/20 p-6 transition-colors hover:border-primary/50 hover:shadow-md">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`打开 ${project.title} 项目主页`}
            class="absolute inset-0 z-10 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          ><span class="sr-only">打开 {project.title} 项目主页</span></a>
          <div class="flex justify-between items-start mb-4">
            <div class="space-y-1">
              <CardTitle className="text-xl font-bold">
                {project.title}
              </CardTitle>
              <p class="text-sm text-muted-foreground">
                {project.org}
              </p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-muted text-2xl shrink-0">
              {project.icon}
            </div>
          </div>
          
          <CardContent className="flex-1 p-0 mb-6">
            <p class="text-muted-foreground leading-relaxed text-sm">
              {project.description}
            </p>
          </CardContent>
          
          <CardFooter className="relative z-20 flex gap-3 p-0">
            <Button variant="outline" size="sm" className="h-9 px-4 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground rounded-md" asChild>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                查看主页
              </a>
            </Button>
            <Button variant="outline" size="sm" className="h-9 px-4 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground rounded-md" asChild>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                Github
              </a>
            </Button>
          </CardFooter>
        </Card>
      ))}
    </div>
  </section>
</PublicLayout>
