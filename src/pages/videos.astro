---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { Film } from "lucide-react";
---

<PublicLayout title="视频" description="杨振的 AI 短视频作品、创作实验与制作记录。">
  <section class="container max-w-5xl py-10 lg:py-16">
    <div class="max-w-2xl">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">VIDEO · 视频作品</p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">把想法做成视频</h1>
      <p class="mt-4 text-base leading-7 text-muted-foreground sm:text-lg">
        这里会收录 AI 短视频、内容创作实验，以及制作过程中的一些记录。
      </p>
    </div>

    <div class="mt-10 rounded-2xl border border-dashed border-border bg-muted/20 px-6 py-14 text-center sm:px-10">
      <Film className="mx-auto h-8 w-8 text-muted-foreground" aria-hidden="true" />
      <h2 class="mt-4 text-lg font-medium">视频作品正在整理中</h2>
      <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-muted-foreground">
        作品上线后会在这里展示视频、作品简介和观看入口。
      </p>
    </div>
  </section>
</PublicLayout>
