---
import PublicLayout from "@/layouts/PublicLayout.astro";

const videos = [
  {
    title: "iPhone Duo",
    kind: "AI 概念短片",
    description: "围绕 iPhone Duo 概念创作的产品短片。",
    duration: "0:15",
    poster: "/videos/iphone-duo-poster.jpg",
    src: "/media/videos/iphone-duo-film.mp4",
  },
  {
    title: "观月瑞幸",
    kind: "AI 品牌短片",
    description: "以清晨与咖啡为灵感的瑞幸创意短片。",
    duration: "0:15",
    poster: "/videos/luckin-morning-poster.jpg",
    src: "/media/videos/luckin-morning-v10.mp4",
  },
  {
    title: "NBA 揭幕战：雷霆 VS 马刺",
    kind: "AI 体育短片",
    description: "记录雷霆对阵马刺的 NBA 揭幕战创作实验。",
    duration: "1:00",
    poster: "/videos/nba-thunder-spurs-poster.jpg",
    src: "/media/videos/nba-thunder-spurs-60s-v2.mp4",
  },
];
---

<PublicLayout title="视频作品" description="杨振的 AI 漫剧与短视频作品，记录创作过程和实践。">
  <section class="container max-w-5xl py-10 lg:py-16">
    <header class="max-w-2xl">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground">VIDEO · 视频作品</p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">把想法做成视频</h1>
      <p class="mt-4 text-base leading-7 text-muted-foreground sm:text-lg">
        AI 短片与创作实验。这里记录作品，也记录从想法到成片的过程。
      </p>
    </header>

    <article class="mt-10 grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:items-center md:gap-12">
      <div class="mx-auto w-full max-w-sm overflow-hidden rounded-2xl border border-border bg-black shadow-sm">
        <video
          class="block max-h-[78svh] w-full object-contain"
          controls
          playsinline
          preload="none"
          poster="/videos/hengwen-an-poster.jpg"
          aria-label="鉴画师收下新徒"
        >
          <source src="/media/videos/hengwen-an.mp4" type="video/mp4">
        </video>
      </div>

      <div class="py-2">
        <p class="mb-3 text-sm font-medium text-muted-foreground">AI 漫剧 <span aria-hidden="true">·</span> 清河镇 · 旧事</p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">鉴画师收下新徒</h2>
        <p class="mt-4 max-w-xl text-base leading-7 text-muted-foreground">
          我的第一部 AI 漫剧短片，记录一次从创意到成片的创作实践。
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
          <span>时长 3:14</span>
          <a class="font-medium text-foreground underline-offset-4 hover:underline" href="/media/videos/hengwen-an.mp4" target="_blank" rel="noreferrer">
            单独打开视频 ↗
          </a>
        </div>
      </div>
    </article>

    <section class="mt-16" aria-labelledby="more-videos-title">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="mb-2 text-sm font-medium text-muted-foreground">更多作品</p>
          <h2 id="more-videos-title" class="text-2xl font-semibold tracking-tight sm:text-3xl">短片与创作实验</h2>
        </div>
        <p class="text-sm text-muted-foreground">3 部作品</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {videos.map((video) => (
          <article class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
            <div class="flex h-64 items-center justify-center bg-black sm:h-80">
              <video
                class="h-full max-h-full max-w-full object-contain"
                controls
                playsinline
                preload="none"
                poster={video.poster}
                aria-label={`播放 ${video.title}`}
              >
                <source src={video.src} type="video/mp4">
              </video>
            </div>
            <div class="p-5 sm:p-6">
              <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-muted-foreground">
                <span class="rounded-full bg-muted px-2.5 py-1">{video.kind}</span>
                <span>{video.duration}</span>
              </div>
              <h3 class="text-xl font-semibold tracking-tight">{video.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{video.description}</p>
              <a
                class="mt-4 inline-flex text-sm font-medium text-foreground underline-offset-4 hover:underline"
                href={video.src}
                target="_blank"
                rel="noreferrer"
              >
                单独打开视频 ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>
</PublicLayout>
