---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { getDb } from "@/db";
import { categories, posts, postsToCategories, postsToTags, tags } from "@/db/schema";
import { and, desc, eq, inArray, ne } from "drizzle-orm";
import { marked } from "marked";
import { format } from "date-fns";
import { Badge } from "@/components/ui/badge";
import { PostActions } from "@/components/PostActions";
import { createPublicPostVisibilityFilter } from "@/lib/publishing";
import { getSuggestedPostCategorySlug, postCategories, type PostCategorySlug } from "@/lib/post-categories";

// export const prerender = true;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const db = getDb(Astro.locals.runtime.env.DB);
const post = await db
  .select()
  .from(posts)
  .where(and(eq(posts.slug, slug), createPublicPostVisibilityFilter()))
  .get();

if (!post) return Astro.redirect("/404");

const postTags = await db.select({ id: tags.id, name: tags.name })
  .from(tags)
  .innerJoin(postsToTags, eq(tags.id, postsToTags.tagId))
  .where(eq(postsToTags.postId, post.id))
  .all();

const candidatePosts = await db.select({
  id: posts.id,
  title: posts.title,
  slug: posts.slug,
  excerpt: posts.excerpt,
  publishedAt: posts.publishedAt,
})
  .from(posts)
  .where(and(createPublicPostVisibilityFilter(), ne(posts.id, post.id)))
  .orderBy(desc(posts.publishedAt))
  .limit(40)
  .all();

const candidateIds = candidatePosts.map((candidate) => candidate.id);
const categoryRows = candidateIds.length
  ? await db.select({ postId: postsToCategories.postId, slug: categories.slug })
      .from(postsToCategories)
      .innerJoin(categories, eq(categories.id, postsToCategories.categoryId))
      .where(inArray(postsToCategories.postId, [post.id, ...candidateIds]))
      .all()
  : [];
const assignedCategoryByPost = new Map<number, PostCategorySlug>();
categoryRows.forEach(({ postId, slug }) => {
  if (postCategories.some((category) => category.slug === slug)) {
    assignedCategoryByPost.set(postId, slug as PostCategorySlug);
  }
});

const tagRows = candidateIds.length
  ? await db.select({ postId: postsToTags.postId, tagId: postsToTags.tagId, name: tags.name })
      .from(postsToTags)
      .innerJoin(tags, eq(tags.id, postsToTags.tagId))
      .where(inArray(postsToTags.postId, candidateIds))
      .all()
  : [];
const candidateTags = new Map<number, Set<number>>();
const candidateTagNames = new Map<number, string[]>();
tagRows.forEach(({ postId, tagId, name }) => {
  if (!candidateTags.has(postId)) candidateTags.set(postId, new Set());
  candidateTags.get(postId)!.add(tagId);
  if (!candidateTagNames.has(postId)) candidateTagNames.set(postId, []);
  candidateTagNames.get(postId)!.push(name);
});

const currentCategory = assignedCategoryByPost.get(post.id)
  ?? getSuggestedPostCategorySlug(post, postTags.map((tag) => tag.name));
const currentTagIds = new Set(postTags.map((tag) => tag.id));
const rankedCandidates = candidatePosts.map((candidate) => {
  const candidateCategory = assignedCategoryByPost.get(candidate.id)
    ?? getSuggestedPostCategorySlug(candidate, candidateTagNames.get(candidate.id) ?? []);
  const sharedTags = [...(candidateTags.get(candidate.id) ?? [])]
    .filter((tagId) => currentTagIds.has(tagId)).length;
  const sameCategory = Boolean(currentCategory && candidateCategory === currentCategory);
  return { candidate, score: (sameCategory ? 100 : 0) + sharedTags * 10 };
});
const rankedRelatedPosts = rankedCandidates
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || (b.candidate.publishedAt?.getTime() ?? 0) - (a.candidate.publishedAt?.getTime() ?? 0));
const relatedPosts = (rankedRelatedPosts.length >= 3 ? rankedRelatedPosts : candidatePosts.map((candidate) => ({ candidate, score: 0 })))
  .slice(0, 3)
  .map(({ candidate }) => candidate);

const toc: { id: string; title: string; level: number }[] = [];
const slugOccurrences = new Map<string, number>();
const parsedContent = marked.parse(post.content);
const content = parsedContent.replace(/<h([23])>([\s\S]*?)<\/h\1>/g, (_match, level: string, headingHtml: string) => {
  const title = headingHtml
    .replace(/<[^>]*>/g, "")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .trim();
  const baseId = title
    .toLocaleLowerCase()
    .replace(/[^\w\u4e00-\u9fff]+/g, "-")
    .replace(/^-+|-+$/g, "") || `section-${toc.length + 1}`;
  const occurrence = slugOccurrences.get(baseId) ?? 0;
  slugOccurrences.set(baseId, occurrence + 1);
  const id = occurrence === 0 ? baseId : `${baseId}-${occurrence + 1}`;

  toc.push({ id, title, level: Number(level) });
  return `<h${level} id="${id}" style="scroll-margin-top: 6rem">${headingHtml}</h${level}>`;
});
const readingText = post.content
  .replace(/```[\s\S]*?```/g, "")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/<[^>]*>/g, "")
  .replace(/[#*`_~>\[\]()]/g, "")
  .replace(/\s/g, "");
const estimatedReadingMinutes = Math.max(1, Math.ceil(readingText.length / 400));



const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.metaTitle || post.title,
  "description": post.metaDescription || post.excerpt || "",
  "datePublished": post.publishedAt?.toISOString(),
  "dateModified": post.updatedAt?.toISOString() || post.publishedAt?.toISOString(),
  "image": post.coverImage ? [post.coverImage] : undefined,
  "author": [{
      "@type": "Person",
      "name": "杨振",
      "url": "https://yangzhenai.top"
  }]
};

---

<PublicLayout
  title={post.metaTitle || post.title}
  description={post.metaDescription || post.excerpt || undefined}
  image={post.coverImage || undefined}
>
    <div aria-hidden="true" class="fixed inset-x-0 top-0 z-[60] h-1 bg-transparent">
      <div data-reading-progress class="h-full origin-left scale-x-0 bg-primary"></div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="container min-w-0 max-w-3xl py-6 lg:py-10">
    <div class="flex flex-col items-start gap-4 border-b pb-10">
        <div class="flex w-full flex-col gap-2">
            <div class="flex items-center justify-between w-full">
                <div class="flex items-center space-x-2 text-sm text-muted-foreground">
                    <time datetime={post.publishedAt?.toISOString()}>
                        {post.publishedAt ? format(post.publishedAt, "yyyy年MM月dd日") : ""}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>约 {estimatedReadingMinutes} 分钟</span>
                </div>
            </div>
            <div class="flex flex-wrap gap-2">
                {postTags.map(tag => (
                    <Badge variant="secondary" className="max-w-full break-all font-normal text-xs">#{tag.name}</Badge>
                ))}
            </div>
        </div>
        <h1 class="break-words text-4xl font-extrabold tracking-tight lg:text-5xl">
            {post.title}
        </h1>
        {post.coverImage && (
          <img
            src={post.coverImage}
            alt={post.title}
            class="mt-4 w-full rounded-2xl border object-cover shadow-sm"
          />
        )}
    </div>
    {toc.length >= 3 && (
      <details class="my-8 rounded-xl border border-border bg-muted/20 px-4 py-3">
        <summary class="cursor-pointer font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          文章目录 <span class="ml-1 text-sm font-normal text-muted-foreground">{toc.length} 个章节</span>
        </summary>
        <nav aria-label="文章目录" class="pt-3">
          <ol class="space-y-2 text-sm">
            {toc.map((item) => (
              <li class={item.level === 3 ? "pl-4" : ""}>
                <a class="text-muted-foreground transition-colors hover:text-foreground" href={`#${item.id}`}>{item.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}
    <div class="post-content prose prose-stone dark:prose-invert max-w-none py-10" set:html={content} />
    
    <PostActions 
      client:load 
      postId={post.id} 
      initialLikes={post.likes} 
      postUrl={Astro.url.href} 
    />

    {relatedPosts.length > 0 && (
      <section aria-labelledby="related-posts-title" class="mt-10 border-t border-border pt-8">
        <h2 id="related-posts-title" class="mb-4 text-xl font-semibold tracking-tight">继续阅读</h2>
        <div class="grid gap-3 sm:grid-cols-3">
          {relatedPosts.map((relatedPost) => (
            <a
              href={`/posts/${relatedPost.slug}`}
              class="group min-w-0 rounded-xl border border-border p-4 transition-colors hover:bg-accent/50"
            >
              <h3 class="line-clamp-2 font-medium leading-snug group-hover:text-primary">{relatedPost.title}</h3>
              {relatedPost.excerpt && <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{relatedPost.excerpt}</p>}
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
  <script is:inline>
    (() => {
      const progressBar = document.querySelector("[data-reading-progress]");
      if (!(progressBar instanceof HTMLElement)) return;

      const updateReadingProgress = () => {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollableHeight > 0 ? window.scrollY / scrollableHeight : 0;
        progressBar.style.transform = `scaleX(${Math.min(Math.max(progress, 0), 1)})`;
      };

      window.addEventListener("scroll", updateReadingProgress, { passive: true });
      window.addEventListener("resize", updateReadingProgress);
      updateReadingProgress();
    })();
  </script>
  <style>
    @media (max-width: 639px) {
      .post-content {
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .post-content :global(pre) {
        box-sizing: border-box;
        max-width: 100%;
        overflow-x: auto;
      }

      .post-content :global(img),
      .post-content :global(video),
      .post-content :global(iframe) {
        max-width: 100%;
      }

      .post-content :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
      }
    }
  </style>
</PublicLayout>
